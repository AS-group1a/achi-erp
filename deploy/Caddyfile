{$SITE_ADDRESS} {
	encode gzip

	# --- ACHI theme override (tier 3) -------------------------------------
	# Serve our stylesheet, then rewrite </head> so it loads AFTER upstream's own
	# CSS and wins on cascade. No upstream file is modified — OCE_VERSION still
	# upgrades cleanly. See overrides/README.md.
	handle /achi-theme.css {
		root * /srv/overrides
		file_server
	}

	# Sidebar "Call Log" entry (tier 3, no fork). Serves the injector and rewrites
	# </head> to load it. See modules/README.md ("it is not in their sidebar").
	handle /achi-nav.js {
		root * /srv/overrides
		file_server
	}

	# Upstream precaches index.html before our response rewrite. Serve a small
	# pass-through worker that clears that stale shell and keeps navigation online.
	handle /sw.js {
		header Cache-Control "no-store, max-age=0"
		header Service-Worker-Allowed "/"
		root * /srv/overrides
		rewrite * /achi-sw.js
		file_server
	}

	# One-time escape hatch for browsers still controlled by upstream's cached
	# navigation fallback. /api is explicitly excluded by that service worker.
	handle /api/achi-browser-reset {
		header Clear-Site-Data `"cache", "storage"`
		header Cache-Control "no-store, max-age=0"
		root * /srv/overrides
		rewrite * /browser-reset.html
		file_server
	}

	replace {
		"</head>" `<link rel="stylesheet" href="/achi-theme.css?v=11"><script src="/achi-nav.js?v=74" defer></script><script src="/api/v1/achi/ui/comment.js?v=7" defer></script></head>`
	}

	# Upstream documents three hard proxy requirements (deploy/docker/README.md):
	#   1. body limit >= 2GB — large CAD/PDF/point-cloud uploads
	#   2. .mjs served as JavaScript — else the pdf.js worker never loads and the
	#      take-off viewer renders BLANK
	#   3. WebSocket upgrade for /api/v1/notifications/ws and collaboration presence
	# Caddy does (2) and (3) natively; (1) is unlimited unless capped.
	request_body {
		max_size 2GB
	}

	# --- ACHI access gate (tier 3) ---------------------------------------
	# Limit non-grandfathered users to the ACHI pages. Only API calls carry the
	# bearer token, so gating /api/* is what actually protects the data; the SPA
	# shell itself is served to everyone (a limited user just sees empty OCE
	# pages because their data calls 403). forward_auth asks our own /authz
	# endpoint per request; that endpoint fails OPEN and is a no-op until an
	# admin seeds the grandfather list, so this block is inert until switched on.
	# The /authz subrequest is dispatched straight to the app, so it does not
	# recurse through this matcher.
	handle /api/* {
		# forward_auth GETs /authz with the original request's headers — so the
		# caller's Authorization bearer rides along for identification — and sets
		# X-Forwarded-Uri to the original path for the per-endpoint decision. 2xx
		# lets the request proceed; anything else is copied back to the client.
		forward_auth app:8080 {
			uri /api/v1/achi/authz
		}
		reverse_proxy app:8080 {
			flush_interval -1     # don't buffer SSE (pack full-install streams progress)
			# Upstream sends geolocation=(), which blocks the Call Log GPS button
			# even when the user has allowed location in the browser and Windows.
			header_down Permissions-Policy "geolocation=(self), microphone=(), camera=()"
		}
	}

	reverse_proxy app:8080 {
		flush_interval -1     # don't buffer SSE (pack full-install streams progress)
		# Keep the privacy-sensitive APIs disabled while allowing this same-origin
		# application to request location with the user's explicit permission.
		header_down Permissions-Policy "geolocation=(self), microphone=(), camera=()"
	}
}
